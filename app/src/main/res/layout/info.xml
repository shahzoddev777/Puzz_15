<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/puzlinfo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_clean_gradient">

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/orqaga"
        android:layout_width="80dp"
        android:layout_height="44dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/btn_back"
        android:elevation="4dp"
        android:src="@drawable/ic_back"
        android:stateListAnimator="@null"
    />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="100dp"
        android:letterSpacing="0.05"
        android:text="@string/app_name"
        android:fontFamily="@font/rogonez"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/info_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/edit_text_back"
        android:elevation="2dp"
        android:fontFamily="@font/youre"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:padding="20dp"
        android:text="@string/info_description"
        android:textColor="#F4EFEF"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center"
        android:layout_marginBottom="30dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_instagram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="100dp"
            android:backgroundTint="#15FFFFFF"
            android:src="@drawable/ic_instagram" />

        <ImageView
            android:id="@+id/btn_github"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:src="@drawable/ic_github" />

        <ImageView
            android:id="@+id/btn_telegram"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:backgroundTint="#15FFFFFF"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_telegram" />
    </LinearLayout>


</FrameLayout>